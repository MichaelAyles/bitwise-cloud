# Database
POSTGRES_USER=bitwise
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bitwise

# Redis
REDIS_PASSWORD=CHANGE_ME_ANOTHER_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING

# Public hostname (your Tailscale machine name)
