# Database
POSTGRES_USER=bitwise
POSTGRES_PASSWORD=           # generate: openssl rand -base64 32
POSTGRES_DB=bitwise

# Redis
REDIS_PASSWORD=              # generate: openssl rand -base64 32

# JWT
JWT_SECRET=                  # generate: openssl rand -base64 64

# Public hostname
PUBLIC_HOST=https://app.bitwise.cloud

# Optional: rate limits
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_UPLOAD=10/hour

# --- Production only (docker-compose.prod.yml) ---

# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=
