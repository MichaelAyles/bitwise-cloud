:80 {
    # API routes
    handle /api/* {
        reverse_proxy backend:8000
    }

    # MCP endpoint
    handle /mcp/* {
        reverse_proxy backend:8000
    }

    # Plugin marketplace
    handle /plugin {
        root * /srv
        rewrite * /marketplace.json
        header Content-Type application/json
        file_server
    }

    # Frontend SPA
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
