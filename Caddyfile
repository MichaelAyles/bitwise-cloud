:80 {
    # API routes
    handle /api/* {
        request_body {
            max_size 110MB
        }
        reverse_proxy backend:8000
    }

    # MCP endpoint
    handle /mcp/* {
        reverse_proxy backend:8000
    }

    # Frontend SPA
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
